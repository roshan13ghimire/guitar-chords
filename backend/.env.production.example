
# GUITAR CHORDS - PRODUCTION ENVIRONMENT
#
# Template only.
# Do not place real credentials in this file.
# Configure values in the hosting provider.

DJANGO_ENV=production

DJANGO_PRODUCTION_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET

DJANGO_ALLOWED_HOSTS=api.example.com

DJANGO_CORS_ALLOWED_ORIGINS=https://www.example.com

DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com

DJANGO_TRUST_PROXY_SSL_HEADER=false

DJANGO_HSTS_SECONDS=0

# Production PostgreSQL

DB_NAME=REPLACE_WITH_PRODUCTION_DB_NAME
DB_USER=REPLACE_WITH_PRODUCTION_DB_USER
DB_PASSWORD=REPLACE_WITH_PRODUCTION_DB_PASSWORD
DB_HOST=REPLACE_WITH_PRODUCTION_DB_HOST
DB_PORT=5432

# Shared cache for submission throttling.
#
# Use an actual Redis service.
# Prefer rediss:// when TLS is required.

DJANGO_REDIS_URL=rediss://REPLACE_WITH_REDIS_CONNECTION
